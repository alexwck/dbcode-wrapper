+		display: none;
+	}
+
+	.dbcode-wrapper-toolbar,
+	.dbcode-wrapper-toolbar-group {
+		gap: 2px;
+	}
+}
+
+@media (max-width: 760px) {
+	.dbcode-wrapper-brand,
+	.dbcode-wrapper-toolbar-divider {
+		display: none;
+	}
+}
+
+/* The redesign uses a quiet macOS title row above a database context bar. */
+.monaco-workbench.dbcode-wrapper-focused {
+	--dbcode-wrapper-shell: #18191e;
+	--dbcode-wrapper-raised: #1e2026;
+	--dbcode-wrapper-hover: #272932;
+	--dbcode-wrapper-border: #30323a;
+	--dbcode-wrapper-border-strong: #424550;
+	--dbcode-wrapper-text: #e7e8ed;
+	--dbcode-wrapper-muted: #9da1ad;
+	--dbcode-wrapper-success: #57c28a;
+	background: #111216;
+}
+
+.monaco-workbench.dbcode-wrapper-focused .part.titlebar {
+	box-shadow: none;
+	background: #202126;
+	border-bottom: 1px solid var(--dbcode-wrapper-border-strong);
+}
+
+.monaco-workbench.dbcode-wrapper-focused .part.titlebar > .titlebar-container {
+	position: relative;
+	align-items: flex-start;
+	background: #202126;
+}
+
+.monaco-workbench.dbcode-wrapper-focused .part.titlebar > .titlebar-container > .titlebar-left,
+.monaco-workbench.dbcode-wrapper-focused .part.titlebar > .titlebar-container > .titlebar-right {
+	position: relative;
+	z-index: 2;
+	height: 30px;
+}
+
+.monaco-workbench.dbcode-wrapper-focused .part.titlebar > .titlebar-container > .titlebar-center,
+.monaco-workbench.dbcode-wrapper-focused .part.titlebar > .titlebar-container.has-center > .titlebar-center {
+	position: absolute;
+	inset: 0;
+	display: block;
+	width: auto;
+	max-width: none;
+	height: 100%;
+	margin: 0;
+	pointer-events: none;
+}
+
+.monaco-workbench.dbcode-wrapper-focused .part.titlebar > .titlebar-container > .titlebar-center > .window-title {
+	position: absolute;
+	top: 0;
+	left: 78px;
+	right: 78px;
+	display: flex !important;
+	height: 30px;
+	align-items: center;
+	justify-content: center;
+	margin: 0;
+	color: #cfd1d8;
+	font-size: 12px;
+	font-weight: 600;
+	pointer-events: none;
+}
+
+.dbcode-wrapper-toolbar.dbcode-wrapper-database-contextbar {
+	position: absolute;
+	left: 0;
+	right: 0;
+	bottom: 0;
+	display: flex;
+	width: auto;
+	height: 52px;
+	padding: 0 10px;
+	gap: 8px;
+	color: var(--dbcode-wrapper-text);
+	background: #1c1d22;
+	border-top: 1px solid var(--dbcode-wrapper-border);
+	pointer-events: auto;
+}
+
+.dbcode-wrapper-toolbar-group.database-actions {
+	flex: 1 1 auto;
+	gap: 4px;
+}
+
+.dbcode-wrapper-toolbar-divider {
+	height: 25px;
+	background: var(--dbcode-wrapper-border);
+}
+
+.dbcode-wrapper-toolbar-button {
+	height: 30px;
+	min-width: 30px;
+	padding: 0 8px;
+	gap: 7px;
+	border-radius: 3px;
+	color: var(--dbcode-wrapper-muted);
+	cursor: pointer;
+}
+
+.dbcode-wrapper-toolbar-button:hover,
+.dbcode-wrapper-toolbar-button:focus-visible,
+.dbcode-wrapper-toolbar-button.active,
+.dbcode-wrapper-toolbar-button[aria-pressed='true'] {
+	border-color: var(--dbcode-wrapper-border-strong);
+	color: var(--dbcode-wrapper-text);
+	background: var(--dbcode-wrapper-hover);
+}
+
+.dbcode-wrapper-toolbar-button[data-dbcode-wrapper-action='connections'] {
+	border-color: var(--dbcode-wrapper-border-strong);
+	color: var(--dbcode-wrapper-text);
+	background: var(--dbcode-wrapper-raised);
+	font-weight: 600;
+}
+
+.dbcode-wrapper-toolbar-button[data-dbcode-wrapper-action='connection-tools'] {
+	min-width: 22px;
+	margin-left: -4px;
+	padding: 0 3px;
+}
+
+.dbcode-wrapper-toolbar-button[data-dbcode-wrapper-action='new-query'] {
+	border-color: var(--dbcode-wrapper-accent);
+	color: #fff;
+	background: var(--dbcode-wrapper-accent);
+	font-weight: 600;
+}
+
+.dbcode-wrapper-toolbar-button[data-dbcode-wrapper-action='new-query']:hover,
+.dbcode-wrapper-toolbar-button[data-dbcode-wrapper-action='new-query']:focus-visible {
+	border-color: var(--dbcode-wrapper-accent-hover);
+	background: var(--dbcode-wrapper-accent-hover);
+}
+
+.dbcode-wrapper-extension-state {
+	flex: 0 0 auto;
+	display: inline-flex;
+	align-items: center;
+	gap: 6px;
+	color: var(--dbcode-wrapper-success);
+	font-size: 11px;
+}
+
+.dbcode-wrapper-extension-state .codicon {
+	font-size: 8px;
+}
+
+.dbcode-wrapper-extension-state.starting {
+	color: var(--dbcode-wrapper-muted);
+}
+
+.dbcode-wrapper-toolbar-button[data-dbcode-wrapper-action='release-status'] {
+	flex: 0 0 auto;
+	min-width: 26px;
+	padding: 0 5px;
+}
+
+.dbcode-wrapper-toolbar-button[data-dbcode-wrapper-release-status='update-available'] {
+	color: var(--dbcode-wrapper-accent-hover);
+}
+
+.dbcode-wrapper-toolbar-button[data-dbcode-wrapper-release-status='ready'] {
+	color: var(--dbcode-wrapper-success);
+}
+
+.dbcode-wrapper-toolbar-button[data-dbcode-wrapper-release-status='offline'],
+.dbcode-wrapper-toolbar-button[data-dbcode-wrapper-release-status='invalid'] {
+	color: var(--dbcode-wrapper-muted);
+}
+
+.monaco-workbench.dbcode-wrapper-focused > .notifications-toasts {
+	right: 8px;
+	bottom: 8px;
+}
+
+.monaco-workbench.dbcode-wrapper-focused > .notifications-toasts .notification-toast-container > .notification-toast {
+	margin: 6px;
+	overflow: hidden;
+	border: 1px solid var(--dbcode-wrapper-border-strong);
+	border-radius: 6px;
+	background: var(--dbcode-wrapper-raised);
+	box-shadow: 0 14px 34px rgb(0 0 0 / 42%);
+}
+
+.monaco-workbench.dbcode-wrapper-focused > .notifications-toasts .notifications-list-container,
+.monaco-workbench.dbcode-wrapper-focused > .notifications-toasts .notification-toast .monaco-scrollable-element,
+.monaco-workbench.dbcode-wrapper-focused > .notifications-toasts .notification-toast .monaco-list-row {
+	border-radius: 5px;
+	background: var(--dbcode-wrapper-raised);
+}
+
+.monaco-workbench.dbcode-wrapper-focused .breadcrumbs-control {
+	display: none !important;
+}
+
+.monaco-workbench.dbcode-wrapper-focused .part.editor > .content .editor-group-container > .title {
+	background: #1d1e23;
+	border-bottom: 1px solid var(--dbcode-wrapper-border);
+}
+
+.monaco-workbench.dbcode-wrapper-focused .part.editor > .content .editor-group-container.dbcode-wrapper-sql-editor-group > .title .editor-actions,
+.monaco-workbench.dbcode-wrapper-focused .part.editor > .content .editor-group-container > .title .editor-actions .action-item:has(.action-label.codicon-toolbar-more),
+.monaco-workbench.dbcode-wrapper-focused .part.editor > .content .editor-group-container > .title .editor-actions .action-item:has(.action-label.codicon-split-horizontal),
+.monaco-workbench.dbcode-wrapper-focused .part.editor > .content .editor-group-container > .title .editor-actions .action-item:has(.action-label.codicon-split-vertical) {
+	display: none !important;
+}
+
+.monaco-workbench.dbcode-wrapper-focused .part.editor > .content {
+	background: #14151a;
+}
+
+.monaco-workbench.dbcode-wrapper-focused .part.sidebar {
+	background: var(--dbcode-wrapper-shell);
+	border-right: 1px solid var(--dbcode-wrapper-border-strong);
+}
+
+.monaco-workbench.dbcode-wrapper-focused .part.panel {
+	border-color: var(--dbcode-wrapper-border-strong);
+	background: #14151a;
+}
+
+/* Lock the only settings route to its DBCode filter and remove generic settings navigation. */
+.monaco-workbench.dbcode-wrapper-focused .settings-editor > .settings-header {
+	display: none !important;
+}
+
+.monaco-workbench.dbcode-wrapper-focused .settings-editor > .settings-body .split-view-view:has(.settings-toc-wrapper) {
+	display: none !important;
+}
+
+.monaco-workbench.dbcode-wrapper-focused .settings-editor > .settings-body .split-view-view:has(.settings-tree-container) {
+	left: 0 !important;
+	width: 100% !important;
+	transform: none !important;
+}
+
+.monaco-workbench.dbcode-wrapper-focused .settings-editor > .settings-body .settings-tree-container {
+	width: 100% !important;
+}
+
+/* The Jupyter notebook is kernel infrastructure for DBCode, not a second notebook product. */
+.monaco-workbench.dbcode-wrapper-focused .tab[aria-label*='dbcode-wrapper-python-kernel.ipynb'],
+.monaco-workbench.dbcode-wrapper-focused .tab:has(.label-name[title*='dbcode-wrapper-python-kernel.ipynb']) {
+	display: none !important;
+}
+
+.monaco-workbench.dbcode-wrapper-focused .editor-instance:has(.notebook-editor[data-uri*='dbcode-wrapper-python-kernel.ipynb']) {
+	visibility: hidden !important;
+}
+
+/* Keep unchanged DBCode webviews visible if Code OSS creates a zero-sized clipping layer. */
+.monaco-workbench.dbcode-wrapper-focused > div:has(> div > iframe.webview[src*='extensionId=dbcode.dbcode'][src*='purpose=webviewView']) {
+	inset: 0 !important;
+	width: 100% !important;
+	height: 100% !important;
+	clip-path: none !important;
+}
+
+@media (max-width: 1100px) {
+	.monaco-workbench.dbcode-wrapper-focused .part.titlebar > .titlebar-container > .titlebar-center,
+	.monaco-workbench.dbcode-wrapper-focused .part.titlebar > .titlebar-container.has-center > .titlebar-center {
+		margin: 0;
+	}
+
+	.dbcode-wrapper-extension-state {
+		display: none;
+	}
+}
+
+@media (max-width: 760px) {
+	.dbcode-wrapper-toolbar.dbcode-wrapper-database-contextbar {
+		padding: 0 6px;
+		gap: 3px;
+	}
+}
